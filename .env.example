# Development only. Defaults do not authorize real model calls.
# Model preflight/budget examples are offline declarations; see docs/model-access.md.
# No model credential variable is resolved or configured by those commands.
API_HOST=127.0.0.1
API_PORT=3100
AGENT_HOST=127.0.0.1
AGENT_PORT=3200
# Opt in explicitly; default keeps health-only scaffold.
AGENT_MODE=scaffold
# Separate service authentication, not a model key. Required for offline-fixture/live-service.
AGENT_INTERNAL_TOKEN=
AGENT_PLANNING_MODE=deterministic
# Qianwen AI Platform key. Fill locally only; never commit a real key.
# Default acceptance is plan-only. --execute additionally needs an authorized JSON config.
INTERVIEW_QIANWEN_API_KEY=
# Dedicated ASR credential. Legacy variable name preserved; selected config determines the platform.
# Current selection: Qianwen AI platform Beijing / qwen3.8-omni-flash.
# Never automatically reuse the LLM key. These values do not enable paid calls.
INTERVIEW_BAILIAN_ASR_API_KEY=
# Only used when explicitly starting live-service; keep empty by default.
AGENT_LIVE_CONFIG_PATH=
# Optional Agent-only SQLite operation store; operator-owned local absolute path, never a model-supplied path.
# Empty keeps the existing in-memory runtime. Does not create formal business tables or authorize paid calls.
AGENT_DURABLE_DB_PATH=
INTERVIEW_API_URL=http://127.0.0.1:3100
# Local Compose credentials only. Use separate managed secrets before deployment.
DATABASE_URL=postgresql://interview:local-dev-only@127.0.0.1:5432/interview
