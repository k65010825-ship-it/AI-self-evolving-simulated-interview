    "agent:knowledge:demo": "bun run scripts/demo-curated-knowledge.ts",
    "agent:answers:eval": "bun run scripts/answer-benchmark.ts",
    "agent:answers:semantic": "bun run scripts/semantic-support.ts",
    "agent:answers:evidence": "bun run scripts/evidence-support.ts",
    "agent:clarification:eval": "bun run scripts/clarification-loop.ts",
