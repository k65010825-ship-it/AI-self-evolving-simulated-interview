    "agent:question:ack:demo": "bun run scripts/demo-question-ack.ts",
    "agent:model:recovery:demo": "bun run scripts/demo-model-recovery.ts",
    "agent:durable:demo": "bun run scripts/demo-durable-runtime.ts",
    "agent:clarification:durable": "bun run scripts/durable-clarification-acceptance.ts",
