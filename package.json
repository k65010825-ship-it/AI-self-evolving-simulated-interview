    "agent:model:budget:demo": "bun run scripts/model-access.ts --demo",
    "agent:model:acceptance": "bun run scripts/live-bailian-acceptance.ts",
    "agent:quality:batch": "bun run scripts/quality-batch.ts",
    "agent:feedback:review": "bun run scripts/feedback-review.ts",
    "agent:feedback:revision:demo": "bun run scripts/feedback-revision.ts",
    "agent:closeout:preview:demo": "bun run scripts/demo-closeout-preview.ts",
    "agent:journey": "bun run scripts/agent-journey.ts",
    "agent:diagnostics:demo": "bun run scripts/demo-output-diagnostics.ts",
    "agent:commit:demo": "bun run scripts/demo-workflow-commit.ts",
    "agent:delivery": "bun run scripts/agent-delivery.ts",
    "agent:reliability": "bun run scripts/agent-reliability.ts",
    "agent:shutdown:demo": "bun run scripts/demo-shutdown.ts",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "check:knowledge": "bun run scripts/check-knowledge.ts",
    "openapi:generate": "bun run scripts/generate-openapi.ts",
    "openapi:lint": "redocly lint docs/openapi.yaml docs/agent-openapi.yaml",
    "dev:api": "bun run apps/api/src/index.ts",
    "dev:agent": "bun run apps/agent/src/index.ts",
    "agent:field": "bun run scripts/agent-field.ts"
  },
  "overrides": {
    "minimatch": "11.0.3",
    "undici": "8.12.3"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "1.4.0",
    "@earendil-works/pi-coding-agent": "1.4.0",
    "@redocly/cli": "2.72.1",
    "@types/bun": "1.4.4",
    "@types/node": "24.19.2",
    "typebox": "1.3.27",
    "typescript": "7.0.2",
    "yaml": "2.9.1"
  },
  "optionalDependencies": {
    "@oven/bun-windows-x64": "1.4.4"
  },
  "dependencies": {
    "drizzle-orm": "0.45.4",
    "hono": "4.13.16",
    "postgres": "4.0.0",
    "zod": "4.6.7"
