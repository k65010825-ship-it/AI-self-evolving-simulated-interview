    "pi:offline": "bun run experiments/pi-sdk/offline-spike.ts",
    "agent:state:demo": "bun run scripts/demo-agent-state.ts",
    "agent:context:demo": "bun run scripts/demo-agent-context.ts",
    "agent:scoring:demo": "bun run scripts/demo-agent-scoring.ts",
