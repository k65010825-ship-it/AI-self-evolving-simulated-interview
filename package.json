    "agent:memory:demo": "bun run scripts/demo-agent-memory.ts",
    "agent:reflection:demo": "bun run scripts/demo-agent-reflection.ts",
    "agent:experiment:demo": "bun run scripts/demo-policy-experiment.ts",
    "agent:learning:demo": "bun run scripts/demo-learning-retest.ts",
    "agent:practice:demo": "bun run scripts/demo-practice-planning.ts",
    "agent:runtime:demo": "bun run scripts/demo-agent-runtime.ts",
    "agent:speech:demo": "bun run scripts/demo-speech.ts",
    "agent:asr:preflight": "bun run scripts/asr-preflight.ts",
    "agent:asr:demo": "bun run scripts/demo-asr-provider.ts",
    "agent:asr:acceptance": "bun run scripts/asr-acceptance.ts",
    "agent:speech:http:demo": "bun run scripts/demo-speech-http.ts",
    "pilot:setup": "bun run scripts/pilot.ts setup",
