{
  "version": 1,
  "PilotAnswer": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "operationId": {
        "type": "string",
        "minLength": 1,
        "maxLength": 80,
        "pattern": "^[A-Za-z0-9_.-]+$"
      },
      "expectedRevision": {
        "type": "integer",
        "minimum": 0,
        "maximum": 9007199254740991
      },
      "text": {
        "type": "string",
        "minLength": 1,
        "maxLength": 10000
      },
      "speechId": {
        "type": "string",
        "minLength": 1,
        "maxLength": 80,
        "pattern": "^[A-Za-z0-9_.-]+$"
      }
    },
    "required": [
      "operationId",
      "expectedRevision",
      "text"
    ],
    "additionalProperties": false
  },
  "PilotCommand": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "operationId": {
        "type": "string",
        "minLength": 1,
        "maxLength": 80,
        "pattern": "^[A-Za-z0-9_.-]+$"
      },
      "expectedRevision": {
        "type": "integer",
        "minimum": 0,
        "maximum": 9007199254740991
      }
    },
    "required": [
      "operationId",
      "expectedRevision"
    ],
    "additionalProperties": false
  },
  "PilotLogin": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "userId": {
        "type": "string",
        "minLength": 1,
        "maxLength": 80,
        "pattern": "^[A-Za-z0-9_.-]+$"
      },
      "password": {
        "type": "string",
        "minLength": 1,
        "maxLength": 256
      }
    },
    "required": [
      "userId",
      "password"
    ],
    "additionalProperties": false
  },
  "PilotOperationView": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "operationId": {
        "type": "string",
        "minLength": 1,
        "maxLength": 80,
        "pattern": "^[A-Za-z0-9_.-]+$"
      },
      "sessionId": {
        "type": "string",
        "minLength": 1,
        "maxLength": 80,
        "pattern": "^[A-Za-z0-9_.-]+$"
      },
      "status": {
        "type": "string",
        "enum": [
          "running",
          "completed",
          "failed",
          "interrupted"
        ]
      },
      "errorCode": {
        "type": [
          "string",
          "null"
        ]
      }
    },
    "required": [
      "operationId",
      "sessionId",
      "status",
      "errorCode"
    ],
    "additionalProperties": false
  },
  "PilotReport": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "evidenceMode": {
        "type": "string"
      },
      "coverage": {
        "type": "object",
        "properties": {
          "totalAnswers": {
            "type": "number"
          },
          "scoredAnswers": {
            "type": "number"
          },
          "unscoredAnswers": {
            "type": "number"
          }
        },
        "required": [
          "totalAnswers",
          "scoredAnswers",
          "unscoredAnswers"
        ]
      },
      "skills": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "skillId": {
              "type": "string"
            },
            "label": {
              "type": "string"
            },
            "mastery": {
              "type": [
                "number",
                "null"
              ]
            },
            "confidence": {
              "type": "number"
            }
          },
          "required": [
            "skillId",
            "label",
            "mastery",
            "confidence"
          ]
        }
      },
      "answers": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "questionId": {
              "type": "string"
            },
            "questionText": {
              "type": "string"
            },
            "strengths": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "improvements": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "criteria": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string"
                  },
                  "label": {
                    "type": "string"
                  },
                  "score": {
                    "type": [
                      "number",
                      "null"
                    ]
                  },
                  "maxScore": {
                    "type": "number"
                  },
                  "action": {
                    "type": [
                      "string",
                      "null"
                    ]
                  }
                },
                "required": [
                  "id",
                  "label",
                  "score",
                  "maxScore",
                  "action"
                ]
              }
            }
          },
          "required": [
            "questionId",
            "questionText",
            "strengths",
            "improvements",
            "criteria"
          ]
        }
      },
      "studyPlan": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "skillId": {
              "type": "string"
            },
            "label": {
              "type": "string"
            },
            "minutes": {
              "type": "number"
            },
            "actions": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "required": [
            "skillId",
            "label",
            "minutes",
            "actions"
          ]
        }
      },
      "unscoredAnswers": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "questionId": {
              "type": "string"
            },
            "reason": {
              "type": "string"
            }
          },
          "required": [
            "questionId",
            "reason"
          ]
        }
      },
      "warnings": {
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "expression": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string"
          },
          "summary": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "status",
          "summary"
        ]
      }
    },
    "required": [
      "evidenceMode",
      "coverage",
      "skills",
      "answers",
      "studyPlan",
      "unscoredAnswers",
      "warnings",
      "expression"
    ],
    "additionalProperties": false
  },
  "PilotRoles": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "array",
    "items": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "enum": [
            "java-backend",
            "web-frontend"
          ]
        },
        "label": {
          "type": "string"
        },
        "skills": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "id",
        "label",
        "skills"
      ]
    }
  },
  "PilotSessionCreate": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "operationId": {
        "type": "string",
        "minLength": 1,
        "maxLength": 80,
        "pattern": "^[A-Za-z0-9_.-]+$"
      },
      "roleId": {
        "type": "string",
        "enum": [
          "java-backend",
          "web-frontend"
        ]
      },
      "goal": {
        "type": "string",
        "minLength": 1,
        "maxLength": 500
      },
      "durationMinutes": {
        "type": "integer",
        "minimum": 15,
        "maximum": 25
      },
      "pressure": {
        "default": false,
        "type": "boolean"
      }
    },
    "required": [
      "operationId",
      "roleId",
      "goal",
      "durationMinutes"
    ],
    "additionalProperties": false
  },
  "PilotSessionView": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "sessionId": {
        "type": "string",
        "minLength": 1,
        "maxLength": 80,
        "pattern": "^[A-Za-z0-9_.-]+$"
      },
      "roleId": {
        "type": "string",
        "enum": [
          "java-backend",
          "web-frontend"
        ]
      },
      "revision": {
        "type": "integer",
        "minimum": -9007199254740991,
        "maximum": 9007199254740991
      },
      "phase": {
        "type": "string"
      },
      "startedAt": {
        "type": "number"
      },
      "deadlineAt": {
        "type": "number"
      },
      "question": {
        "anyOf": [
          {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "text": {
                "type": "string"
              }
            },
            "required": [
              "id",
              "text"
            ],
            "additionalProperties": false
          },
          {
            "type": "null"
          }
        ]
      },
      "clarification": {
        "anyOf": [
          {
            "type": "object",
            "properties": {
              "prompt": {
                "type": "string"
              },
              "previousText": {
                "type": "string"
              }
            },
            "required": [
              "prompt",
              "previousText"
            ],
            "additionalProperties": false
          },
          {
            "type": "null"
          }
        ]
      },
      "answeredCount": {
        "type": "integer",
        "minimum": 0,
        "maximum": 9007199254740991
      },
      "scoredCount": {
        "type": "integer",
        "minimum": 0,
        "maximum": 9007199254740991
      },
      "unscoredCount": {
        "type": "integer",
        "minimum": 0,
        "maximum": 9007199254740991
      },
      "report": {
        "anyOf": [
          {
            "type": "object",
            "properties": {
              "evidenceMode": {
                "type": "string"
              },
              "coverage": {
                "type": "object",
                "properties": {
                  "totalAnswers": {
                    "type": "number"
                  },
                  "scoredAnswers": {
                    "type": "number"
                  },
                  "unscoredAnswers": {
                    "type": "number"
                  }
                },
                "required": [
                  "totalAnswers",
                  "scoredAnswers",
                  "unscoredAnswers"
                ]
              },
              "skills": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "skillId": {
                      "type": "string"
                    },
                    "label": {
                      "type": "string"
                    },
                    "mastery": {
                      "type": [
                        "number",
                        "null"
                      ]
                    },
                    "confidence": {
                      "type": "number"
                    }
                  },
                  "required": [
                    "skillId",
                    "label",
                    "mastery",
                    "confidence"
                  ]
                }
              },
              "answers": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "questionId": {
                      "type": "string"
                    },
                    "questionText": {
                      "type": "string"
                    },
                    "strengths": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    },
                    "improvements": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    },
                    "criteria": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "id": {
                            "type": "string"
                          },
                          "label": {
                            "type": "string"
                          },
                          "score": {
                            "type": [
                              "number",
                              "null"
                            ]
                          },
                          "maxScore": {
                            "type": "number"
                          },
                          "action": {
                            "type": [
                              "string",
                              "null"
                            ]
                          }
                        },
                        "required": [
                          "id",
                          "label",
                          "score",
                          "maxScore",
                          "action"
                        ]
                      }
                    }
                  },
                  "required": [
                    "questionId",
                    "questionText",
                    "strengths",
                    "improvements",
                    "criteria"
                  ]
                }
              },
              "studyPlan": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "skillId": {
                      "type": "string"
                    },
                    "label": {
                      "type": "string"
                    },
                    "minutes": {
                      "type": "number"
                    },
                    "actions": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    }
                  },
                  "required": [
                    "skillId",
                    "label",
                    "minutes",
                    "actions"
                  ]
                }
              },
              "unscoredAnswers": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "questionId": {
                      "type": "string"
                    },
                    "reason": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "questionId",
                    "reason"
                  ]
                }
              },
              "warnings": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "expression": {
                "type": "object",
                "properties": {
                  "status": {
                    "type": "string"
                  },
                  "summary": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  }
                },
                "required": [
                  "status",
                  "summary"
                ]
              }
            },
            "required": [
              "evidenceMode",
              "coverage",
              "skills",
              "answers",
              "studyPlan",
              "unscoredAnswers",
              "warnings",
              "expression"
            ],
            "additionalProperties": false
          },
          {
            "type": "null"
          }
        ]
      },
      "evidenceMode": {
        "type": "string",
        "enum": [
          "offline-fixture",
          "live-model"
        ]
      },
      "knowledgeStatus": {
        "type": "string",
        "enum": [
          "draft-pilot",
          "reviewed-only"
        ]
      }
    },
    "required": [
      "sessionId",
      "roleId",
      "revision",
      "phase",
      "startedAt",
      "deadlineAt",
      "question",
      "clarification",
      "answeredCount",
      "scoredCount",
      "unscoredCount",
      "report",
      "evidenceMode",
      "knowledgeStatus"
    ],
    "additionalProperties": false
  },
  "PilotSpeechConfirm": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "expectedVersion": {
        "type": "integer",
        "minimum": 0,
        "maximum": 9007199254740991
      },
      "text": {
        "type": "string",
        "minLength": 1,
        "maxLength": 10000
      }
    },
    "required": [
      "expectedVersion",
      "text"
    ],
    "additionalProperties": false
  },
  "PilotSpeechCreate": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "expectedRevision": {
        "type": "integer",
        "minimum": 0,
        "maximum": 9007199254740991
      },
      "sha256": {
        "type": "string",
        "pattern": "^[a-f0-9]{64}$"
      },
      "byteLength": {
        "type": "integer",
        "minimum": 44,
        "maximum": 4194304
      }
    },
    "required": [
      "expectedRevision",
      "sha256",
      "byteLength"
    ],
    "additionalProperties": false
  },
  "PilotSpeechView": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "speechId": {
        "type": "string",
        "minLength": 1,
        "maxLength": 80,
        "pattern": "^[A-Za-z0-9_.-]+$"
      },
      "status": {
        "type": "string"
      },
      "version": {
        "type": "integer",
        "minimum": 0,
        "maximum": 9007199254740991
      },
      "originalText": {
        "type": [
          "string",
          "null"
        ]
      },
      "confirmedText": {
        "type": [
          "string",
          "null"
        ]
      },
      "errorCode": {
        "type": [
          "string",
          "null"
        ]
      },
      "expression": {
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "prefixText": {
        "type": [
          "string",
          "null"
        ]
      }
    },
    "required": [
      "speechId",
      "status",
      "version",
      "originalText",
      "confirmedText",
      "errorCode",
      "expression",
      "prefixText"
    ],
    "additionalProperties": false
  }
}
