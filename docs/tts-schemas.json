{
  "version": 1,
  "QuestionVoiceRequest": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "text": {
        "type": "string",
        "minLength": 1,
        "maxLength": 1000
      },
      "operationId": {
        "type": "string",
        "minLength": 1,
        "maxLength": 160
      },
      "deadlineAt": {
        "type": "integer",
        "minimum": 0,
        "maximum": 9007199254740991
      },
      "sessionId": {
        "type": "string",
        "minLength": 1,
        "maxLength": 80
      },
      "userId": {
        "type": "string",
        "minLength": 1,
        "maxLength": 80
      },
      "roleId": {
        "type": "string",
        "enum": [
          "java-backend",
          "web-frontend"
        ]
      },
      "questionId": {
        "type": "string",
        "minLength": 1,
        "maxLength": 100
      }
    },
    "required": [
      "text",
      "operationId",
      "deadlineAt",
      "sessionId",
      "userId",
      "roleId",
      "questionId"
    ],
    "additionalProperties": false
  },
  "TtsConfig": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "enabled": {
        "type": "boolean"
      },
      "endpoint": {
        "type": "string",
        "const": "https://cn-beijing.maas.qianwenaiapi.com/api/v1/services/aigc/multimodal-generation/generation"
      },
      "model": {
        "type": "string",
        "const": "qwen3-tts-flash"
      },
      "voice": {
        "type": "string",
        "const": "Cherry"
      },
      "credentialEnv": {
        "type": "string",
        "const": "INTERVIEW_BAILIAN_ASR_API_KEY"
      }
    },
    "required": [
      "enabled",
      "endpoint",
      "model",
      "voice",
      "credentialEnv"
    ],
    "additionalProperties": false
  },
  "TtsInput": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "text": {
        "type": "string",
        "minLength": 1,
        "maxLength": 1000
      },
      "operationId": {
        "type": "string",
        "minLength": 1,
        "maxLength": 160
      },
      "deadlineAt": {
        "type": "integer",
        "minimum": 0,
        "maximum": 9007199254740991
      }
    },
    "required": [
      "text",
      "operationId",
      "deadlineAt"
    ],
    "additionalProperties": false
  }
}
