            "sourceGroupId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 100
            },
            "authorId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 100
            },
            "version": {
              "type": "string",
              "minLength": 1,
              "maxLength": 100
            },
            "roleId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 100
            },
            "kind": {
              "type": "string",
              "enum": [
                "answer",
                "knowledge",
                "continuation",
                "expression"
              ]
            },
            "payload": {
              "type": "object",
              "propertyNames": {
                "type": "string"
              },
              "additionalProperties": {}
            },
            "modelScore": {
              "default": null,
              "anyOf": [
                {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                },
                {
                  "type": "null"
                }
              ]
            },
            "sourceReferences": {
              "default": [],
              "maxItems": 100,
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "sourceId": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 100
                  },
                  "sourceVersion": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 100
                  },
                  "locator": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 500
                  }
                },
                "required": [
                  "sourceId",
                  "sourceVersion",
                  "locator"
                ],
                "additionalProperties": false
              }
            }
          },
          "required": [
            "id",
            "sourceGroupId",
            "authorId",
            "version",
            "roleId",
            "kind",
            "payload"
          ],
          "additionalProperties": false
        }
      }
    },
