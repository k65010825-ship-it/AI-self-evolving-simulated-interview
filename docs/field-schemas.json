  "FieldEvidenceInput": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "datasetId": {
        "type": "string",
        "minLength": 1,
        "maxLength": 100
      },
      "developmentGroupIds": {
        "type": "array",
        "items": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        }
      },
      "developmentReviewerIds": {
        "type": "array",
        "items": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        }
      },
      "minimumCases": {
        "default": 8,
        "type": "integer",
        "exclusiveMinimum": 0,
        "maximum": 10000
      },
      "items": {
        "maxItems": 10000,
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 100
