  "FieldKnowledgeReview": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "taskId": {
        "type": "string",
        "minLength": 1,
        "maxLength": 100
      },
      "taskDigest": {
        "type": "string",
        "pattern": "^[a-f0-9]{64}$"
      },
      "reviewId": {
        "type": "string",
        "minLength": 1,
        "maxLength": 100
      },
      "reviewerId": {
        "type": "string",
        "minLength": 1,
        "maxLength": 100
      },
      "reviewedAt": {
        "type": "string",
        "format": "date-time",
        "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
      },
      "decision": {
        "type": "string",
        "enum": [
          "approved",
          "changes_requested"
        ]
      },
      "checks": {
        "type": "object",
        "properties": {
          "technicalAccuracy": {
            "type": "boolean"
          },
          "scoringClarity": {
            "type": "boolean"
          },
          "sourceAlignment": {
            "type": "boolean"
          },
          "roleFit": {
            "type": "boolean"
          }
        },
        "required": [
          "technicalAccuracy",
          "scoringClarity",
          "sourceAlignment",
          "roleFit"
        ],
        "additionalProperties": false
      },
      "note": {
        "type": "string",
        "minLength": 1,
        "maxLength": 4000
      }
    },
    "required": [
      "taskId",
      "taskDigest",
      "reviewId",
      "reviewerId",
      "reviewedAt",
      "decision",
      "checks",
      "note"
    ],
    "additionalProperties": false
  },
