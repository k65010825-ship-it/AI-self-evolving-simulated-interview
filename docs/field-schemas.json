                      "minLength": 1,
                      "maxLength": 100
                    },
                    "questionId": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 100
                    },
                    "sessionId": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 100
                    },
                    "submittedAt": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 9007199254740991
                    },
                    "score": {
                      "anyOf": [
                        {
                          "type": "number",
                          "minimum": 0,
                          "maximum": 1
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    "reviewerId": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 100
                    },
                    "reviewId": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 100
                    },
                    "questionIssuedAt": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 9007199254740991
                    }
                  },
                  "required": [
                    "answerId",
                    "questionId",
                    "sessionId",
                    "submittedAt",
                    "score",
                    "reviewerId",
                    "reviewId",
                    "questionIssuedAt"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "pairId",
            "studentId",
            "arm",
            "sourceGroupId",
            "roleId",
            "skillId",
            "rubricId",
            "rubricVersion",
            "difficulty",
            "dataMode",
            "consentRecordId",
            "learningArtifactId",
            "policyVersion",
            "before",
            "learningVerifiedAt",
            "after"
          ],
          "additionalProperties": false
        }
      }
    },
    "required": [
      "studyId",
      "baselinePolicyVersion",
      "candidatePolicyVersion",
      "developmentGroupIds",
      "pairs"
