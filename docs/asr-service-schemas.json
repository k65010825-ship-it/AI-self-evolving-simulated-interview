{
  "version": 1,
  "config": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "version": {
        "type": "number",
        "const": 1
      },
      "enabled": {
        "type": "boolean"
      },
      "providerId": {
        "type": "string",
        "enum": [
          "bailian",
          "qianwen"
        ]
      },
      "modelId": {
        "type": "string",
        "enum": [
          "qwen3-asr-flash",
          "qwen3.8-omni-flash"
        ]
      },
      "endpoint": {
        "type": "string",
        "format": "uri"
      },
      "credentialEnv": {
        "type": "string",
        "const": "INTERVIEW_BAILIAN_ASR_API_KEY"
      },
      "timeoutMs": {
        "type": "integer",
        "minimum": 1,
        "maximum": 30000
      },
      "maxOutputTokens": {
        "default": 512,
        "type": "integer",
        "minimum": 1,
        "maximum": 4096
      },
      "authorization": {
        "type": "object",
        "properties": {
          "allowLive": {
            "type": "boolean"
          },
          "expiresAt": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          }
        },
        "required": [
          "allowLive",
          "expiresAt"
        ],
        "additionalProperties": false
      },
      "budget": {
        "type": "object",
        "properties": {
          "maxCalls": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100
          },
          "maxTotalAudioMs": {
            "type": "integer",
            "minimum": 1,
            "maximum": 12000000
          },
          "maxCostMicros": {
            "type": "integer",
            "minimum": 1,
            "maximum": 1000000000
          },
          "reserveCostMicrosPerCall": {
            "type": "integer",
            "minimum": 1,
            "maximum": 1000000000
          }
        },
        "required": [
          "maxCalls",
          "maxTotalAudioMs",
          "maxCostMicros",
          "reserveCostMicrosPerCall"
        ],
        "additionalProperties": false
      }
    },
    "required": [
      "version",
      "enabled",
      "providerId",
      "modelId",
      "endpoint",
      "credentialEnv",
      "timeoutMs",
      "maxOutputTokens",
      "authorization",
      "budget"
    ],
    "additionalProperties": false
  },
  "accounting": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "version": {
        "type": "number",
        "const": 1
      },
      "context": {
        "type": "object",
        "properties": {
          "userId": {
            "type": "string",
            "minLength": 1
          },
          "runId": {
            "type": "string",
            "minLength": 1
          },
          "attemptId": {
            "type": "string",
            "minLength": 1
          },
          "roleId": {
            "type": "string",
            "enum": [
              "java-backend",
              "web-frontend"
            ]
          },
          "deadlineAt": {
            "type": "number",
            "minimum": 0
          }
        },
        "required": [
          "userId",
          "runId",
          "attemptId",
          "roleId",
          "deadlineAt"
        ],
        "additionalProperties": false
      },
      "accounting": {
        "type": "string",
        "const": "in-memory-host-declared-cost-holds-not-vendor-billing"
      },
      "vendorBillingVerified": {
        "type": "boolean",
        "const": false
      },
      "blocked": {
        "type": "boolean"
      },
      "callsConsumed": {
        "type": "integer",
        "minimum": 0,
        "maximum": 9007199254740991
      },
      "audioMsConsumed": {
        "type": "number",
        "minimum": 0
      },
      "heldCostMicros": {
        "type": "integer",
        "minimum": 0,
        "maximum": 9007199254740991
      },
      "entries": {
        "maxItems": 100,
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "callId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 100
            },
            "audioMs": {
              "type": "number",
              "exclusiveMinimum": 0,
              "maximum": 120000
            },
            "reservedCostMicros": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1000000000
            },
            "status": {
              "type": "string",
              "enum": [
                "dispatched",
                "responded",
                "rejected",
                "unknown"
              ]
            },
            "httpStatus": {
              "type": "integer",
              "minimum": 100,
              "maximum": 599
            },
            "usage": {
              "type": "object",
              "properties": {
                "inputTokens": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "outputTokens": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "totalTokens": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                }
              },
              "required": [
                "inputTokens",
                "outputTokens",
                "totalTokens"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "callId",
            "audioMs",
            "reservedCostMicros",
            "status"
          ],
          "additionalProperties": false
        }
      }
    },
    "required": [
      "version",
      "context",
      "accounting",
      "vendorBillingVerified",
      "blocked",
      "callsConsumed",
      "audioMsConsumed",
      "heldCostMicros",
      "entries"
    ],
    "additionalProperties": false
  }
}
