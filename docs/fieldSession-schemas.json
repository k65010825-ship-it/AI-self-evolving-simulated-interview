{
  "version": 1,
  "FieldAnswerCommand": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "roleId": {
        "type": "string",
        "enum": [
          "java-backend",
          "web-frontend"
        ]
      },
      "questionId": {
        "type": "string",
        "minLength": 1,
        "maxLength": 80,
        "pattern": "^[A-Za-z0-9_.-]+$"
      },
      "text": {
        "type": "string",
        "minLength": 2,
        "maxLength": 10000
      }
    },
    "required": [
      "roleId",
      "questionId",
      "text"
    ],
    "additionalProperties": false
  },
  "FieldParticipant": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "participantId": {
        "type": "string",
        "minLength": 1,
        "maxLength": 80,
        "pattern": "^[A-Za-z0-9_.-]+$"
      },
      "consentRecordId": {
        "type": "string",
        "minLength": 1,
        "maxLength": 80,
        "pattern": "^[A-Za-z0-9_.-]+$"
      },
      "consentedAt": {
        "type": "integer",
        "exclusiveMinimum": 0,
        "maximum": 9007199254740991
      },
      "developmentReviewerIds": {
        "maxItems": 100,
        "type": "array",
        "items": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80,
          "pattern": "^[A-Za-z0-9_.-]+$"
        }
      }
    },
    "required": [
      "participantId",
      "consentRecordId",
      "consentedAt",
      "developmentReviewerIds"
    ],
    "additionalProperties": false
  },
  "FieldSessionManifest": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "participantId": {
        "type": "string",
        "minLength": 1,
        "maxLength": 80,
        "pattern": "^[A-Za-z0-9_.-]+$"
      },
      "consentRecordId": {
        "type": "string",
        "minLength": 1,
        "maxLength": 80,
        "pattern": "^[A-Za-z0-9_.-]+$"
      },
      "consentedAt": {
        "type": "integer",
        "exclusiveMinimum": 0,
        "maximum": 9007199254740991
      },
      "developmentReviewerIds": {
        "maxItems": 100,
        "type": "array",
        "items": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80,
          "pattern": "^[A-Za-z0-9_.-]+$"
        }
      },
      "version": {
        "type": "number",
        "const": 1
      },
      "studyId": {
        "type": "string",
        "minLength": 1,
        "maxLength": 80,
        "pattern": "^[A-Za-z0-9_.-]+$"
      },
      "createdAt": {
        "type": "integer",
        "exclusiveMinimum": 0,
        "maximum": 9007199254740991
      },
      "origin": {
        "type": "string",
        "const": "participant-declared-not-authenticated"
      },
      "knowledgeStatus": {
        "type": "string",
        "const": "draft"
      },
      "items": {
        "minItems": 16,
        "maxItems": 16,
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1
            },
            "roleId": {
              "type": "string",
              "enum": [
                "java-backend",
                "web-frontend"
              ]
            },
            "skillId": {
              "type": "string",
              "minLength": 1
            },
            "questionType": {
              "type": "string",
              "enum": [
                "technical",
                "project",
                "scenario",
                "behavioral"
              ]
            },
            "difficulty": {
              "type": "integer",
              "minimum": 1,
              "maximum": 5
            },
            "question": {
              "type": "string",
              "minLength": 1
            },
            "keyPoints": {
              "minItems": 1,
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "rubric": {
              "minItems": 1,
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "criterionId": {
                    "type": "string"
                  },
                  "description": {
                    "type": "string"
                  },
                  "maxScore": {
                    "type": "number",
                    "exclusiveMinimum": 0
                  },
                  "weight": {
                    "type": "number",
                    "exclusiveMinimum": 0
                  },
                  "verificationGoal": {
                    "type": "object",
                    "properties": {
                      "id": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 100
                      },
                      "version": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 100
                      },
                      "actionAliases": {
                        "minItems": 1,
                        "maxItems": 12,
                        "type": "array",
                        "items": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 80
                        }
                      },
                      "targetAliases": {
                        "minItems": 1,
                        "maxItems": 12,
                        "type": "array",
                        "items": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 80
                        }
                      },
                      "observationAliases": {
                        "minItems": 1,
                        "maxItems": 12,
                        "type": "array",
                        "items": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 80
                        }
                      },
                      "observationPolicy": {
                        "type": "object",
                        "properties": {
                          "kind": {
                            "type": "string",
                            "enum": [
                              "count",
                              "duration"
                            ]
                          },
                          "conditionAliases": {
                            "minItems": 1,
                            "maxItems": 12,
                            "type": "array",
                            "items": {
                              "type": "string",
                              "minLength": 1,
                              "maxLength": 80
                            }
                          },
                          "predicateAliases": {
                            "minItems": 1,
                            "maxItems": 12,
                            "type": "array",
                            "items": {
                              "type": "string",
                              "minLength": 1,
                              "maxLength": 80
                            }
                          }
                        },
                        "required": [
                          "kind",
                          "conditionAliases"
                        ],
                        "additionalProperties": false
                      }
                    },
                    "required": [
                      "id",
                      "version",
                      "actionAliases",
                      "targetAliases",
                      "observationAliases"
                    ],
                    "additionalProperties": false
                  },
                  "dimension": {
                    "type": "string",
                    "enum": [
                      "correctness",
                      "depth",
                      "ownership",
                      "logic",
                      "communication",
                      "relevance",
                      "verification"
                    ]
                  },
                  "evidenceRule": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 1000
                  },
                  "anchors": {
                    "minItems": 2,
                    "maxItems": 10,
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "score": {
                          "type": "number",
                          "minimum": 0,
                          "maximum": 100
                        },
                        "description": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 1000
                        }
                      },
                      "required": [
                        "score",
                        "description"
                      ],
                      "additionalProperties": false
                    }
                  }
                },
                "required": [
                  "criterionId",
                  "description",
                  "maxScore",
                  "weight"
                ],
                "additionalProperties": false
              }
            },
            "sourceIds": {
              "minItems": 1,
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "version": {
              "type": "string",
              "minLength": 1
            },
            "reviewStatus": {
              "type": "string",
              "enum": [
                "draft",
                "reviewed"
              ]
            }
          },
          "required": [
            "id",
            "roleId",
            "skillId",
            "questionType",
            "difficulty",
            "question",
            "keyPoints",
            "rubric",
            "sourceIds",
            "version",
            "reviewStatus"
          ],
          "additionalProperties": false
        }
      },
      "sourceReferences": {
        "type": "object",
        "propertyNames": {
          "type": "string"
        },
        "additionalProperties": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "sourceId": {
                "type": "string"
              },
              "sourceVersion": {
                "type": "string"
              },
              "locator": {
                "type": "string"
              }
            },
            "required": [
              "sourceId",
              "sourceVersion",
              "locator"
            ],
            "additionalProperties": false
          }
        }
      }
    },
    "required": [
      "participantId",
      "consentRecordId",
      "consentedAt",
      "developmentReviewerIds",
      "version",
      "studyId",
      "createdAt",
      "origin",
      "knowledgeStatus",
      "items",
      "sourceReferences"
    ],
    "additionalProperties": false
  }
}
