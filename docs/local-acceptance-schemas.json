{
  "batch": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "version": {
        "type": "number",
        "const": 1
      },
      "id": {
        "type": "string",
        "pattern": "^[a-f0-9]{24}$"
      },
      "path": {
        "type": "string",
        "minLength": 1,
        "maxLength": 2048
      },
      "createdAt": {
        "type": "integer",
        "minimum": 0,
        "maximum": 9007199254740991
      },
      "mode": {
        "type": "string",
        "enum": [
          "text",
          "speech"
        ]
      },
      "sourceRoot": {
        "type": "string",
        "minLength": 1,
        "maxLength": 2048
      },
      "sourceManifest": {
        "minItems": 1,
        "maxItems": 5000,
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "path": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_./-]+$"
            },
            "sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          },
          "required": [
            "path",
            "sha256"
          ],
          "additionalProperties": false
        }
      },
      "sourceDigest": {
        "type": "string",
        "pattern": "^[a-f0-9]{64}$"
      },
      "artifact": {
        "type": "object",
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "production",
              "injected-test-only"
            ]
          },
          "output": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048
          },
          "executable": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048
          },
          "entry": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048
          },
          "assetsRoot": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048
          },
          "manifestSha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "files": {
            "minItems": 2,
            "maxItems": 2,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "path": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 2048
                },
                "sha256": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                }
              },
              "required": [
                "path",
                "sha256"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "kind",
          "output",
          "executable",
          "entry",
          "assetsRoot",
          "manifestSha256",
          "files"
        ],
        "additionalProperties": false
      },
      "samples": {
        "minItems": 2,
        "maxItems": 2,
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "roleId": {
              "type": "string",
              "enum": [
                "java-backend",
                "web-frontend"
              ]
            },
            "origin": {
              "type": "string",
              "enum": [
                "synthetic-development",
                "user-provided"
              ]
            },
            "answerText": {
              "type": "string",
              "minLength": 1,
              "maxLength": 10000
            },
            "audio": {
              "type": "object",
              "properties": {
                "path": {
                  "type": "string",
                  "pattern": "^inputs\\/(java-backend|web-frontend)\\.wav$"
                },
                "sha256": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                },
                "bytes": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "durationMs": {
                  "type": "number",
                  "exclusiveMinimum": 0,
                  "maximum": 120000
                }
              },
              "required": [
                "path",
                "sha256",
                "bytes",
                "durationMs"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "roleId",
            "origin",
            "answerText"
          ],
          "additionalProperties": false
        }
      },
      "liveConfig": {
        "type": "object",
        "properties": {
          "profile": {
            "type": "object",
            "properties": {
              "profileId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 100,
                "pattern": "^[A-Za-z0-9_.-]+$"
              },
              "version": {
                "type": "string",
                "minLength": 1,
                "maxLength": 100,
                "pattern": "^[A-Za-z0-9_.-]+$"
              },
              "limits": {
                "type": "object",
                "properties": {
                  "maxCalls": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 100
                  },
                  "maxConcurrent": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 8
                  },
                  "maxInputTokens": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 1000000
                  },
                  "maxOutputTokens": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 1000000
                  },
                  "maxTotalTokens": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 10000000
                  },
                  "maxCostMicros": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 1000000000000
                  },
                  "maxInputCharacters": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 100000
                  },
                  "maxOutputCharacters": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 100000
                  },
                  "timeoutMs": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 60000
                  }
                },
                "required": [
                  "maxCalls",
                  "maxConcurrent",
                  "maxInputTokens",
                  "maxOutputTokens",
                  "maxTotalTokens",
                  "maxCostMicros",
                  "maxInputCharacters",
                  "maxOutputCharacters",
                  "timeoutMs"
                ],
                "additionalProperties": false
              },
              "mode": {
                "type": "string",
                "const": "live-service"
              },
              "providerId": {
                "type": "string",
                "enum": [
                  "bailian",
                  "qianwen"
                ]
              },
              "modelId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 100,
                "pattern": "^[A-Za-z0-9_.-]+$"
              },
              "apiFamily": {
                "type": "string",
                "const": "openai-completions"
              },
              "endpoint": {
                "type": "string",
                "format": "uri"
              },
              "credentialSource": {
                "type": "object",
                "properties": {
                  "kind": {
                    "type": "string",
                    "const": "env-reference-only"
                  },
                  "name": {
                    "type": "string",
                    "pattern": "^INTERVIEW_[A-Z0-9_]{1,80}$"
                  }
                },
                "required": [
                  "kind",
                  "name"
                ],
                "additionalProperties": false
              },
              "pricing": {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 100,
                    "pattern": "^[A-Za-z0-9_.-]+$"
                  },
                  "version": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 100,
                    "pattern": "^[A-Za-z0-9_.-]+$"
                  },
                  "currency": {
                    "type": "string",
                    "const": "CNY"
                  },
                  "rates": {
                    "type": "object",
                    "properties": {
                      "inputMicrosPerMillionTokens": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 1000000000
                      },
                      "outputMicrosPerMillionTokens": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 1000000000
                      }
                    },
                    "required": [
                      "inputMicrosPerMillionTokens",
                      "outputMicrosPerMillionTokens"
                    ],
                    "additionalProperties": false
                  },
                  "provenance": {
                    "type": "string",
                    "const": "host-declared-unverified"
                  }
                },
                "required": [
                  "id",
                  "version",
                  "currency",
                  "rates",
                  "provenance"
                ],
                "additionalProperties": false
              }
            },
            "required": [
              "profileId",
              "version",
              "limits",
              "mode",
              "providerId",
              "modelId",
              "apiFamily",
              "endpoint",
              "credentialSource",
              "pricing"
            ],
            "additionalProperties": false
          },
          "authorization": {
            "type": "object",
            "properties": {
              "enabled": {
                "default": false,
                "type": "boolean"
              },
              "operatorApproved": {
                "default": false,
                "type": "boolean"
              },
              "expiresAt": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "maxRuns": {
                "type": "integer",
                "minimum": 1,
                "maximum": 32
              }
            },
            "required": [
              "enabled",
              "operatorApproved",
              "expiresAt",
              "maxRuns"
            ],
            "additionalProperties": false
          },
          "planning": {
            "default": "deterministic",
            "type": "string",
            "enum": [
              "deterministic",
              "pi-knowledge"
            ]
          },
          "outputRepair": {
            "default": "none",
            "type": "string",
            "enum": [
              "none",
              "json-fence-only"
            ]
          },
          "evaluationResponseFormat": {
            "type": "string",
            "enum": [
              "text",
              "json_object"
            ]
          },
          "verificationExtraction": {
            "type": "string",
            "enum": [
              "verbatim-quotes",
              "candidate-refs"
            ]
          },
          "evidenceGrounding": {
            "default": "model-offsets",
            "type": "string",
            "enum": [
              "model-offsets",
              "unique-excerpt",
              "quoted-spans"
            ]
          },
          "questionDelivery": {
            "default": "canonical",
            "type": "string",
            "enum": [
              "canonical",
              "natural-bridge"
            ]
          },
          "recovery": {
            "type": "object",
            "properties": {
              "httpMaxAttempts": {
                "default": 1,
                "type": "integer",
                "minimum": 1,
                "maximum": 3
              },
              "maxModelRepairs": {
                "default": 0,
                "type": "integer",
                "minimum": 0,
                "maximum": 1
              },
              "baseDelayMs": {
                "default": 250,
                "type": "integer",
                "minimum": 1,
                "maximum": 5000
              },
              "maxDelayMs": {
                "default": 3000,
                "type": "integer",
                "minimum": 1,
                "maximum": 5000
              },
              "initialOutputTokens": {
                "type": "integer",
                "minimum": 1,
                "maximum": 1000000
              },
              "maxOutputRecoveries": {
                "default": 0,
                "type": "integer",
                "minimum": 0,
                "maximum": 1
              },
              "truncationMode": {
                "default": "regenerate",
                "type": "string",
                "enum": [
                  "regenerate",
                  "continue"
                ]
              },
              "maxContextCompactions": {
                "default": 0,
                "type": "integer",
                "minimum": 0,
                "maximum": 1
              },
              "autoCompact": {
                "default": {
                  "enabled": false,
                  "windowTokens": 131072,
                  "triggerRatio": 0.8
                },
                "type": "object",
                "properties": {
                  "enabled": {
                    "default": false,
                    "type": "boolean"
                  },
                  "windowTokens": {
                    "default": 131072,
                    "type": "integer",
                    "minimum": 1000,
                    "maximum": 1000000
                  },
                  "triggerRatio": {
                    "default": 0.8,
                    "type": "number",
                    "minimum": 0.1,
                    "maximum": 0.95
                  }
                },
                "required": [
                  "enabled",
                  "windowTokens",
                  "triggerRatio"
                ],
                "additionalProperties": false
              }
            },
            "required": [
              "httpMaxAttempts",
              "maxModelRepairs",
              "baseDelayMs",
              "maxDelayMs",
              "maxOutputRecoveries",
              "truncationMode",
              "maxContextCompactions",
              "autoCompact"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "profile",
          "authorization",
          "planning",
          "outputRepair",
          "evidenceGrounding",
          "questionDelivery",
          "recovery"
        ],
        "additionalProperties": false
      },
      "sessionBudget": {
        "type": "object",
        "properties": {
          "maxCalls": {
            "type": "number",
            "const": 3
          },
          "maxTotalTokens": {
            "type": "number",
            "const": 48000
          },
          "maxCostMicros": {
            "type": "number",
            "const": 1000000
          }
        },
        "required": [
          "maxCalls",
          "maxTotalTokens",
          "maxCostMicros"
        ],
        "additionalProperties": false
      },
      "speechPolicy": {
        "anyOf": [
          {
            "type": "object",
            "properties": {
              "asrConfig": {
                "type": "object",
                "properties": {
                  "version": {
                    "type": "number",
                    "const": 1
                  },
                  "enabled": {
                    "type": "boolean"
                  },
                  "providerId": {
                    "type": "string",
                    "enum": [
                      "bailian",
                      "qianwen"
                    ]
                  },
                  "modelId": {
                    "type": "string",
                    "enum": [
                      "qwen3-asr-flash",
                      "qwen3.8-omni-flash"
                    ]
                  },
                  "endpoint": {
                    "type": "string",
                    "format": "uri"
                  },
                  "credentialEnv": {
                    "type": "string",
                    "const": "INTERVIEW_BAILIAN_ASR_API_KEY"
                  },
                  "timeoutMs": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 30000
                  },
                  "maxOutputTokens": {
                    "default": 512,
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 4096
                  },
                  "authorization": {
                    "type": "object",
                    "properties": {
                      "allowLive": {
                        "type": "boolean"
                      },
                      "expiresAt": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 9007199254740991
                      }
                    },
                    "required": [
                      "allowLive",
                      "expiresAt"
                    ],
                    "additionalProperties": false
                  },
                  "budget": {
                    "type": "object",
                    "properties": {
                      "maxCalls": {
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 100
                      },
                      "maxTotalAudioMs": {
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 12000000
                      },
                      "maxCostMicros": {
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 1000000000
                      },
                      "reserveCostMicrosPerCall": {
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 1000000000
                      }
                    },
                    "required": [
                      "maxCalls",
                      "maxTotalAudioMs",
                      "maxCostMicros",
                      "reserveCostMicrosPerCall"
                    ],
                    "additionalProperties": false
                  }
                },
                "required": [
                  "version",
                  "enabled",
                  "providerId",
                  "modelId",
                  "endpoint",
                  "credentialEnv",
                  "timeoutMs",
                  "maxOutputTokens",
                  "authorization",
                  "budget"
                ],
                "additionalProperties": false
              },
              "ttsConfig": {
                "type": "object",
                "properties": {
                  "enabled": {
                    "type": "boolean"
                  },
                  "endpoint": {
                    "type": "string",
                    "const": "https://cn-beijing.maas.qianwenaiapi.com/api/v1/services/aigc/multimodal-generation/generation"
                  },
                  "model": {
                    "type": "string",
                    "const": "qwen3-tts-flash"
                  },
                  "voice": {
                    "type": "string",
                    "const": "Cherry"
                  },
                  "credentialEnv": {
                    "type": "string",
                    "const": "INTERVIEW_BAILIAN_ASR_API_KEY"
                  }
                },
                "required": [
                  "enabled",
                  "endpoint",
                  "model",
                  "voice",
                  "credentialEnv"
                ],
                "additionalProperties": false
              },
              "asrBudget": {
                "type": "object",
                "properties": {
                  "maxCalls": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 100
                  },
                  "maxCostMicros": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 1000000000000
                  },
                  "reserveCostMicrosPerCall": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 1000000000000
                  },
                  "maxAudioMs": {
                    "type": "integer",
                    "exclusiveMinimum": 0,
                    "maximum": 12000000
                  }
                },
                "required": [
                  "maxCalls",
                  "maxCostMicros",
                  "reserveCostMicrosPerCall",
                  "maxAudioMs"
                ],
                "additionalProperties": false
              },
              "ttsBudget": {
                "type": "object",
                "properties": {
                  "maxCalls": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 100
                  },
                  "maxCostMicros": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 1000000000000
                  },
                  "reserveCostMicrosPerCall": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 1000000000000
                  },
                  "maxCharacters": {
                    "type": "integer",
                    "exclusiveMinimum": 0,
                    "maximum": 100000
                  }
                },
                "required": [
                  "maxCalls",
                  "maxCostMicros",
                  "reserveCostMicrosPerCall",
                  "maxCharacters"
                ],
                "additionalProperties": false
              },
              "totalMaxCostMicros": {
                "type": "integer",
                "minimum": 0,
                "maximum": 1000000000000
              }
            },
            "required": [
              "asrConfig",
              "ttsConfig",
              "asrBudget",
              "ttsBudget",
              "totalMaxCostMicros"
            ],
            "additionalProperties": false
          },
          {
            "type": "null"
          }
        ]
      },
      "credentials": {
        "minItems": 1,
        "maxItems": 3,
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "credentialRef": {
              "type": "string",
              "enum": [
                "acceptance-llm",
                "acceptance-asr",
                "acceptance-tts"
              ]
            },
            "platform": {
              "type": "string",
              "enum": [
                "qianwen",
                "bailian"
              ]
            },
            "env": {
              "type": "string",
              "enum": [
                "INTERVIEW_QIANWEN_API_KEY",
                "INTERVIEW_BAILIAN_ASR_API_KEY"
              ]
            }
          },
          "required": [
            "credentialRef",
            "platform",
            "env"
          ],
          "additionalProperties": false
        }
      },
      "maxRequests": {
        "anyOf": [
          {
            "type": "number",
            "const": 6
          },
          {
            "type": "number",
            "const": 10
          }
        ]
      },
      "maxCostMicros": {
        "anyOf": [
          {
            "type": "number",
            "const": 2000000
          },
          {
            "type": "number",
            "const": 3000000
          }
        ]
      },
      "humanReferenceCount": {
        "type": "number",
        "const": 0
      },
      "qualityClaimEligible": {
        "type": "boolean",
        "const": false
      },
      "digest": {
        "type": "string",
        "pattern": "^[a-f0-9]{64}$"
      }
    },
    "required": [
      "version",
      "id",
      "path",
      "createdAt",
      "mode",
      "sourceRoot",
      "sourceManifest",
      "sourceDigest",
      "artifact",
      "samples",
      "liveConfig",
      "sessionBudget",
      "speechPolicy",
      "credentials",
      "maxRequests",
      "maxCostMicros",
      "humanReferenceCount",
      "qualityClaimEligible",
      "digest"
    ],
    "additionalProperties": false
  },
