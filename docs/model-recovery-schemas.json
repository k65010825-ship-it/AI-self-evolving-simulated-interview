{
  "version": 1,
  "policy": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "httpMaxAttempts": {
        "default": 1,
        "type": "integer",
        "minimum": 1,
        "maximum": 3
      },
      "maxModelRepairs": {
        "default": 0,
        "type": "integer",
        "minimum": 0,
        "maximum": 1
      },
      "baseDelayMs": {
        "default": 250,
        "type": "integer",
        "minimum": 1,
        "maximum": 5000
      },
      "maxDelayMs": {
        "default": 3000,
        "type": "integer",
        "minimum": 1,
        "maximum": 5000
      },
      "initialOutputTokens": {
        "type": "integer",
        "minimum": 1,
        "maximum": 1000000
      },
      "maxOutputRecoveries": {
        "default": 0,
        "type": "integer",
        "minimum": 0,
        "maximum": 1
      },
      "truncationMode": {
        "default": "regenerate",
        "type": "string",
        "enum": [
          "regenerate",
          "continue"
        ]
      },
      "maxContextCompactions": {
        "default": 0,
        "type": "integer",
        "minimum": 0,
        "maximum": 1
      },
      "autoCompact": {
        "default": {
          "enabled": false,
          "windowTokens": 131072,
          "triggerRatio": 0.8
        },
        "type": "object",
        "properties": {
          "enabled": {
            "default": false,
            "type": "boolean"
          },
          "windowTokens": {
            "default": 131072,
            "type": "integer",
            "minimum": 1000,
            "maximum": 1000000
          },
          "triggerRatio": {
            "default": 0.8,
            "type": "number",
            "minimum": 0.1,
            "maximum": 0.95
          }
        },
        "required": [
          "enabled",
          "windowTokens",
          "triggerRatio"
        ],
        "additionalProperties": false
      }
    },
    "required": [
      "httpMaxAttempts",
      "maxModelRepairs",
      "baseDelayMs",
      "maxDelayMs",
      "maxOutputRecoveries",
      "truncationMode",
      "maxContextCompactions",
      "autoCompact"
    ],
    "additionalProperties": false
  },
  "event": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "version": {
        "type": "number",
        "const": 1
      },
      "phase": {
        "type": "string",
        "enum": [
          "http",
          "evaluation"
        ]
      },
      "outcome": {
        "type": "string",
        "enum": [
          "retry-scheduled",
          "repair-scheduled",
          "recovered",
          "stopped",
          "compact-applied",
          "upgrade-scheduled",
          "continue-scheduled"
        ]
      },
      "reason": {
        "type": "string",
        "enum": [
          "http-429",
          "http-503",
          "invalid-json",
          "invalid-schema",
          "attempt-limit",
          "repair-limit",
          "retry-after-limit",
          "budget",
          "unknown",
          "cancelled",
          "deadline",
          "clock",
          "dependency",
          "non-retryable",
          "valid",
          "output-length",
          "context-limit",
          "auto-threshold",
          "no-removable-context"
        ]
      },
      "attempt": {
        "type": "integer",
        "minimum": 1,
        "maximum": 100
      },
      "delayMs": {
        "type": "integer",
        "minimum": 0,
        "maximum": 5000
      }
    },
    "required": [
      "version",
      "phase",
      "outcome",
      "reason",
      "attempt",
      "delayMs"
    ],
    "additionalProperties": false
  }
}
