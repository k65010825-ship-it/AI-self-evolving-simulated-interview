{
  "version": 1,
  "SessionAccountingEntry": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "sessionId": {
        "type": "string",
        "pattern": "^[A-Za-z0-9_.:-]{1,160}$"
      },
      "userId": {
        "type": "string",
        "pattern": "^[A-Za-z0-9_.:-]{1,160}$"
      },
      "roleId": {
        "type": "string",
        "pattern": "^[A-Za-z0-9_.:-]{1,160}$"
      },
      "operationId": {
        "type": "string",
        "pattern": "^[A-Za-z0-9_.:-]{1,160}$"
      },
      "attemptId": {
        "type": "string",
        "pattern": "^[A-Za-z0-9_.:-]{1,160}$"
      },
      "kind": {
        "type": "string",
        "enum": [
          "llm",
          "asr",
          "tts"
        ]
      },
      "reservedCostMicros": {
        "type": "integer",
        "minimum": 1,
        "maximum": 1000000000000
      },
      "pricing": {
        "type": "object",
        "properties": {
          "source": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "version": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "unit": {
            "type": "string",
            "enum": [
              "token",
              "audio-ms",
              "character",
              "request"
            ]
          }
        },
        "required": [
          "source",
          "version",
          "unit"
        ],
        "additionalProperties": false
      },
      "status": {
        "type": "string",
        "enum": [
          "reserved",
          "dispatched",
          "unknown",
          "responded",
          "released",
          "settled"
        ]
      },
      "admittedAt": {
        "type": "integer",
        "minimum": 0,
        "maximum": 9007199254740991
      },
      "actualCostMicros": {
        "type": "integer",
        "minimum": 0,
        "maximum": 1000000000000
      },
      "evidence": {
        "type": "object",
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "host-usage",
              "host-imported-bill"
            ]
          },
          "reference": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        },
        "required": [
          "kind",
          "reference",
          "sha256"
        ],
        "additionalProperties": false
      }
    },
    "required": [
      "sessionId",
      "userId",
      "roleId",
      "operationId",
      "attemptId",
      "kind",
      "reservedCostMicros",
      "pricing",
      "status",
      "admittedAt"
    ],
    "additionalProperties": false
  },
